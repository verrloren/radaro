# Radaro configuration — all optional. Copy to .env in Radaro's data dir (see
# `radaro status`) or the current directory. Radaro runs with ZERO configuration; everything below
# is an upgrade, not a requirement. Real environment variables win over .env.

# --- Storage ---
# Default: radaro.db in the data dir (~/.local/share/radaro, see `radaro status`).
# RADARO_HOME=/home/you/.local/share/radaro
# RADARO_DB=/path/to/radaro.db

# --- Sources ---
# Comma-separated. Zero-config defaults: hackernews,bluesky
# Other options: stackoverflow (no key), reddit, mastodon, rss, x, youtube
# RADARO_SOURCES=hackernews,bluesky
# RADARO_LIMIT=50
# Retry network errors, HTTP 429 and 5xx with exponential backoff (seconds)
# RADARO_RETRIES=2
# RADARO_RETRY_BACKOFF=1.0

# Source keys can also be saved in the dashboard (radaro serve → Setup); a value
# saved there wins over the variable here and applies without a restart. Reddit
# and Mastodon scan with a connected account (Setup → Connect account, or radaro connect).

# Reddit: the Data API requires OAuth (an app client) or a bearer token
# RADARO_REDDIT_CLIENT_ID=
# RADARO_REDDIT_CLIENT_SECRET=
# RADARO_REDDIT_ACCESS_TOKEN=

# X recent search: requires an X developer plan with API v2 search access
# RADARO_X_BEARER_TOKEN=

# YouTube video search: enable YouTube Data API v3 and create an API key
# RADARO_YOUTUBE_API_KEY=

# Mastodon: full-text status search normally requires a user access token
# RADARO_MASTODON_INSTANCE=mastodon.social
# RADARO_MASTODON_ACCESS_TOKEN=

# RSS/Atom: comma-separated feed URLs (blogs, news, Google Alerts RSS, …)
# RADARO_RSS_FEEDS=https://example.com/feed.xml,https://news.example/rss

# --- Alerts ---
# Generic HTTP webhook or Slack incoming webhook. Newly ingested negative
# mentions are queued; failed deliveries are retried on the next scan.
# Keep this secret: Slack webhook URLs are credentials.
# RADARO_WEBHOOK_URL=https://hooks.slack.com/services/...

# SMTP email to one or more comma-separated recipients. TO, FROM and HOST go
# together; USERNAME/PASSWORD are optional but go together.
# RADARO_EMAIL_TO=ops@example.com,owner@example.com
# RADARO_EMAIL_FROM=radaro@example.com
# RADARO_SMTP_HOST=smtp.example.com
# RADARO_SMTP_PORT=587
# Security: starttls (default) | ssl | none (trusted local relay only)
# RADARO_SMTP_SECURITY=starttls
# RADARO_SMTP_USERNAME=
# RADARO_SMTP_PASSWORD=

# Rolling threshold alerts through every configured transport. Both thresholds
# default to 0 (disabled). The baseline is the preceding N complete windows.
# RADARO_ALERT_WINDOW_HOURS=24
# RADARO_ALERT_BASELINE_WINDOWS=7
# RADARO_ALERT_MIN_MENTIONS=5
# Alert when current volume is this many times the baseline average.
# RADARO_ALERT_VOLUME_MULTIPLIER=2.0
# Alert when net sentiment drops by this fraction versus the baseline (0.25 = 25 points).
# RADARO_ALERT_SENTIMENT_DROP=0.25
# Re-arm a recovered event only after this many hours (0 disables the cooldown).
# RADARO_ALERT_COOLDOWN_HOURS=24

# --- Optional LLM (nicer theme labels; opt-in sentiment) ---
# Provider: none (default) | anthropic | openai | ollama
# RADARO_LLM_PROVIDER=none
# RADARO_LLM_MODEL=
# Sentiment stays on the local lexicon unless explicitly switched. LLM mode
# sends up to 1,000 characters of every fetched mention to the provider and
# falls back to the lexicon on any provider error.
# RADARO_SENTIMENT_ANALYZER=lexicon

# Anthropic
# RADARO_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# RADARO_LLM_MODEL=claude-sonnet-5

# OpenAI-compatible (OpenAI, OpenRouter, Together, …)
# RADARO_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# RADARO_LLM_BASE_URL=https://api.openai.com/v1
# RADARO_LLM_MODEL=gpt-4o-mini

# Ollama (analysis stays on your machine)
# RADARO_LLM_PROVIDER=ollama
# RADARO_LLM_HOST=http://localhost:11434
# RADARO_LLM_MODEL=llama3.2
